# Copy to .env (never commit .env) or set these in your hosting provider's
# "Variables" screen. Only ADDON_SECRET is required.

# --- Required ---------------------------------------------------------------

# A long random string. It becomes part of the addon URL:
#   https://<your-host>/<ADDON_SECRET>/manifest.json
# Anyone with that URL can use your server (and your Gemini quota), so treat
# it like a password. Generate one with:  node -e "console.log(require('crypto').randomBytes(20).toString('hex'))"
ADDON_SECRET=

# --- Translation ------------------------------------------------------------

# Your own Gemini API key (free tier available): https://aistudio.google.com/app/api-keys
# Without it the server falls back to Google Translate, which is plainer and
# cannot handle grammatical gender.
GEMINI_API_KEY=

# Model used for translation.
GEMINI_MODEL=gemini-3.1-flash-lite

# The language to translate into, as an ISO 639-2 code. Built-in profiles:
# see src/language/profiles.js (heb, ara, spa, fre, ita, por, pob, ger, rus,
# pol, tur, ...). Default: heb.
TARGET_LANG=heb

# For a language that is not built in (or to adjust one that is):
# TARGET_LANG_NAME=Klingon        # required for a language that is not built in
# TARGET_LANG_LABEL=tlh           # short name used inside the model request
# TARGET_LANG_GOOGLE=             # Google Translate code; empty = no fallback
# TARGET_LANG_RTL=off             # on for right-to-left scripts

# Texts the viewer sees (defaults come from the language profile):
# ADDON_NAME=AI subtitles - Spanish
# MACHINE_LABEL=Spanish - AI translation
# FAILED_NOTICE=The translation did not succeed this time. Try again in a minute.

# --- Storage ----------------------------------------------------------------

# Where finished translations are kept. Point it at a persistent disk
# (on Railway: a volume mounted at /data -> CACHE_DIR=/data/cache).
CACHE_DIR=./cache

# --- Optional switches ------------------------------------------------------

# Google Translate's public web endpoint as fallback (not an official API).
GOOGLE_FALLBACK=on

# Other-language subtitle files given to the model as gender hints (0 = off).
HINT_FILES=3

# Cast list with genders from AniList, for animation.
CAST_LOOKUP=on

# Existing Hebrew subtitles from Wizdom (only used when TARGET_LANG=heb).
# WIZDOM_ADDON_URL=off

# Owner diagnostics (/<secret>/diag/...) used by tools/eval. Keep off unless
# you measure prompts: whoever has the addon URL could run any prompt on your key.
DIAG_ROUTES=off

# Pin the manifest id (useful when upgrading an existing installation).
# ADDON_ID=

# Tuning (defaults are fine):
# PORT=7860
# GEMINI_TIMEOUT_MS=25000
# TRANSLATE_CONCURRENCY=5
# CHUNK_SIZE=80
# MAX_VARIANTS=3
# HOLD_TIMEOUT_MS=110000
# PRETRANSLATE_DELAY_MS=45000
